# ----------------------------------------------------------------------------
# Node.js Core
# ----------------------------------------------------------------------------
# Dependency directories (never commit this as it is generated by npm/yarn)
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# ----------------------------------------------------------------------------
# Logs & Runtime
# ----------------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Process IDs and runtime data
pids
*.pid
*.seed
*.pid.lock

# ----------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Do not commit sensitive data)
# ----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.### env.test.local
.env.production.local

# Leave the example file unignored so teammates know what keys are required
!env.example
!.env.example

# ----------------------------------------------------------------------------
# Testing & Code Coverage
# ----------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output

# ----------------------------------------------------------------------------
# Build Outputs & Framework Caches
# ----------------------------------------------------------------------------
dist/
build/
.next/
out/
.nuxt/
.output/
.svelte-kit/
.cache/
.parcel-cache/

# ----------------------------------------------------------------------------
# IDEs / Editors & OS-Specific Files
# ----------------------------------------------------------------------------
# macOS files
.DS_Store

# Windows files
Thumbs.db

# VS Code
.vscode/
# (Optional) Uncomment the next line if you want to commit shared team tasks/launch settings
# !.vscode/settings.json

# WebStorm / IntelliJ
.idea/
*.iml
